# KernelMind - Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_DB=kernelmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432

# ============================================
# Ollama LLM
# ============================================
OLLAMA_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# Model sizes for reference:
# - llama3.1:8b   (~8GB VRAM/RAM) - Fast, good for development
# - llama3.1:70b  (~40GB VRAM/RAM) - Best quality, requires powerful GPU
# - nomic-embed-text (~500MB) - Text embeddings for RAG

# ============================================
# Backend API
# ============================================
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5076

# Connection String (used by backend)
# Format: Host={host};Port={port};Database={db};Username={user};Password={pass}
CONNECTION_STRING=Host=localhost;Port=5432;Database=kernelmind;Username=postgres;Password=postgres123

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2026
JWT_ISSUER=KernelMind
JWT_AUDIENCE=KernelMindUsers
JWT_EXPIRATION_HOURS=24

# ============================================
# Frontend
# ============================================
FRONTEND_PORT=4200
API_URL=http://localhost:5076

# ============================================
# Docker
# ============================================
COMPOSE_PROJECT_NAME=kernelmind

# ============================================
# Resource Limits (adjust based on your machine)
# ============================================
# Uncomment and adjust based on available resources:

# PostgreSQL
# POSTGRES_MEMORY_LIMIT=1G
# POSTGRES_MEMORY_RESERVATION=512M

# Ollama (requires significant memory for LLM)
# For llama3.1:8b  - minimum 4GB recommended
# For llama3.1:70b - minimum 48GB recommended
# OLLAMA_MEMORY_LIMIT=8G
# OLLAMA_MEMORY_RESERVATION=4G

# Backend
# BACKEND_MEMORY_LIMIT=2G
# BACKEND_MEMORY_RESERVATION=512M

# Frontend
# FRONTEND_MEMORY_LIMIT=256M
# FRONTEND_MEMORY_RESERVATION=128M

# ============================================
# Feature Flags (optional)
# ============================================
# ENABLE_SWAGGER=true
# ENABLE_CORS=true
# LOG_LEVEL=Information

# ============================================
# Development Settings
# ============================================
# DOTNET_WATCH_RESTART_ON_RUDE_EDIT=1
# CHOKIDAR_USEPOLLING=true
